# Copied to .env by `make setup`. Local-only defaults; .env is git-ignored.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
POSTGRES_USER=ukwiki
POSTGRES_PASSWORD=ukwiki
# DVC remote and MLflow artifacts on MinIO
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
# Wikimedia asks for a contact address in the User-Agent
WIKI_CONTACT=you@example.com
# Salt for hashing user names before the version point (design 6.5); change it
USER_HASH_SALT=change-me
# LLM API (Lab 3), Google AI Studio key; never commit it
GEMINI_API_KEY=
